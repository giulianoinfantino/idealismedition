{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/suche",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/recherche",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/recherche.html",
      "destination": "/search",
      "permanent": true
    },
    {
      "source": "/de/recherche",
      "destination": "/de/search",
      "permanent": true
    },
    {
      "source": "/de/recherche.html",
      "destination": "/de/search",
      "permanent": true
    },
    {
      "source": "/unterstuetzen",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/unterstuetzen.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/de/unterstuetzen",
      "destination": "/de/support",
      "permanent": true
    },
    {
      "source": "/de/unterstuetzen.html",
      "destination": "/de/support",
      "permanent": true
    },
    {
      "source": "/datenschutz",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/datenschutz.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/de/datenschutz",
      "destination": "/de/privacy",
      "permanent": true
    },
    {
      "source": "/de/datenschutz.html",
      "destination": "/de/privacy",
      "permanent": true
    },
    {
      "source": "/impressum",
      "destination": "/legal-notice",
      "permanent": true
    },
    {
      "source": "/impressum.html",
      "destination": "/legal-notice",
      "permanent": true
    },
    {
      "source": "/de/impressum",
      "destination": "/de/legal-notice",
      "permanent": true
    },
    {
      "source": "/de/impressum.html",
      "destination": "/de/legal-notice",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/suche/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/de/assets/suche/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/de/assets/:pfad*",
      "destination": "/assets/:pfad*"
    },
    {
      "source": "/de/api/:pfad*",
      "destination": "/api/:pfad*"
    },
    {
      "source": "/de/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/de/manifest.json",
      "destination": "/manifest.json"
    }
  ],
  "functions": {
    "api/ki-frage.js": {
      "maxDuration": 300,
      "includeFiles": "assets/suche/**"
    }
  }
}
